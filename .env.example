# Supabase Configuration
# Add these in your Vercel Project Settings > Environment Variables
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Public URL of the deployed app, with no trailing slash.
# Used to build the auth callback URL sent in Supabase confirmation emails
# and in the Google OAuth redirect. If this is missing in production, signup
# emails will link to localhost.
# Production: https://sevlabx.xyz
# Local dev:  http://localhost:3000
# NOTE: NEXT_PUBLIC_* vars are inlined at build time - redeploy after changing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
